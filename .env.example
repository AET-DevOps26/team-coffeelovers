# Copy this file to .env and fill in the values
# .env is gitignored — never commit real credentials

POSTGRES_DB=coffeelovers
POSTGRES_USER=coffeelovers
POSTGRES_PASSWORD=changeme

# Required when genai service is added
# OPENAI_API_KEY=your_key_here

# Used to sign auth-service JWTs — must be at least 32 bytes for HS256.
# A local-dev default is provided in infra/docker-compose.yml; override here for your own value.
# JWT_SECRET=your_long_random_secret_at_least_32_chars

# GenAI provider mode.
# Supported values:
# - mock: deterministic local provider, no external API key required
# - openai: OpenAI-compatible cloud provider, implemented in a later ticket
# - logos: TUM Logos OpenAI-compatible provider, implemented in a later ticket
GENAI_PROVIDER=mock

# Logging
GENAI_LOG_LEVEL=INFO

# OpenAI configuration
# Do not commit real API keys.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Logos configuration
# Logos requires TUM network or eduVPN.
# Model id must include the "openai/" prefix.
LOGOS_API_KEY=
LOGOS_BASE_URL=https://logos.aet.cit.tum.de/v1
LOGOS_MODEL=openai/gpt-oss-120b

# Grafana local administrator credentials
# Change the password before starting the stack.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
