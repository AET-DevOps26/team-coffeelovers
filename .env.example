# Copy this file to .env and fill in the values
# .env is gitignored — never commit real credentials

POSTGRES_DB=coffeelovers
POSTGRES_USER=coffeelovers
POSTGRES_PASSWORD=changeme

# Required when genai service is added
# OPENAI_API_KEY=your_key_here

# Used to sign auth-service JWTs — must be at least 32 bytes for HS256.
# A local-dev default is provided in infra/docker-compose.yml; override here for your own value.
# JWT_SECRET=your_long_random_secret_at_least_32_chars
