# GenAI provider mode.
# Supported values:
# - mock: deterministic local provider, no external API key required
# - openai: OpenAI-compatible cloud provider, implemented in a later ticket
# - logos: TUM Logos OpenAI-compatible provider, implemented in a later ticket
GENAI_PROVIDER=mock

# Logging
GENAI_LOG_LEVEL=INFO

# OpenAI configuration
# Do not commit real API keys.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Logos configuration
# Logos requires TUM network or eduVPN.
# Model id must include the "openai/" prefix.
LOGOS_API_KEY=
LOGOS_BASE_URL=https://logos.aet.cit.tum.de/v1
LOGOS_MODEL=openai/gpt-oss-120b